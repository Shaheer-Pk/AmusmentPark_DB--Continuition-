<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amusementpark.RidesController"
      styleClass="view-container"
      spacing="20">
    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Ride Management" styleClass="page-title"/>
            <Label text="Monitor ride status and assign operators" styleClass="page-subtitle"/>
        </VBox>
        <Button text="+ Add Ride" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Toolbar -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <TextField fx:id="searchField"
                   promptText="Search by ride name..."
                   styleClass="text-field-flat"
                   prefWidth="300"
                   onKeyReleased="#handleSearch"/>
        <Button text="Search" styleClass="btn-secondary" onAction="#handleSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="recordCountLabel" text="0 records" styleClass="record-count-label"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="ridesTable" styleClass="flat-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"       text="ID"        prefWidth="60"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colName"     text="Ride Name" prefWidth="220"/>
            <TableColumn fx:id="colStatus"   text="Status"    prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colOperator" text="Operator"  prefWidth="200"/>
            <TableColumn fx:id="colActions"  text="Actions"   prefWidth="160" style="-fx-alignment: CENTER;" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="No rides found. Click '+ Add Ride' to get started." styleClass="table-placeholder"/>
        </placeholder>
    </TableView>
</VBox>
