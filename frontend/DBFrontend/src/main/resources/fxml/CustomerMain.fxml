<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.amusementpark.CustomerMainController"
            styleClass="root-pane"
            prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="4">
            <VBox styleClass="sidebar-header" alignment="CENTER">
                <padding><Insets top="32" right="16" bottom="32" left="16"/></padding>
                <Label text="🎟️" style="-fx-font-size: 36px;"/>
                <Label text="APEX GUEST" styleClass="sidebar-app-name"/>
                <Label text="Digital Account Portal" styleClass="sidebar-app-sub"/>
            </VBox>

            <Separator styleClass="sidebar-divider"/>

            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="12" left="8" right="8"/></padding>
                <Button text="  💳   My Digital Pass" styleClass="nav-btn-active" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT;"/>
                <Button text="  🎢   Ride History" styleClass="nav-btn" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT;" disable="true"/>
                <Button text="  🎁   Rewards &amp; Offers" styleClass="nav-btn" maxWidth="Infinity" style="-fx-alignment: CENTER_LEFT;" disable="true"/>
            </VBox>

            <Separator styleClass="sidebar-divider"/>
            <VBox styleClass="sidebar-footer" spacing="8">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label fx:id="customerNameLabel" text="Guest User" styleClass="sidebar-admin-name"/>
                <Label fx:id="customerEmailLabel" text="guest@apexpark.com" styleClass="sidebar-admin-email"/>
                <Button text="Sign Out" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-area">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
            <VBox alignment="CENTER" spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 4);">
                <Label text="🎠" style="-fx-font-size: 64px;"/>
                <Label text="Welcome to Your Apex Park Experience!" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: -ap-text;"/>
                <Label text="Your digital member pass account profile has been securely set up and activated." style="-fx-font-size: 14px; -fx-text-fill: -ap-text-muted;"/>
                <HBox alignment="CENTER" spacing="24" style="-fx-padding: 20 0 0 0;">
                    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 16 32 16 32; -fx-background-color: -ap-bg; -fx-background-radius: 8;">
                        <Label text="Card Balance" style="-fx-font-size: 12px; -fx-text-fill: -ap-text-muted;"/>
                        <Label text="$0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -ap-success;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 16 32 16 32; -fx-background-color: -ap-bg; -fx-background-radius: 8;">
                        <Label text="Reward Points" style="-fx-font-size: 12px; -fx-text-fill: -ap-text-muted;"/>
                        <Label text="0 pts" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -ap-accent;"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>