<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.amusementpark.LoginController"
           styleClass="root-pane">

    <HBox>
        <VBox styleClass="login-brand-panel" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="🎡" styleClass="login-brand-icon"/>
            <Label text="APEX PARK" styleClass="login-brand-title"/>
            <Label fx:id="brandSubtitleLabel" text="Admin &amp; Customer Portal" styleClass="login-brand-subtitle"/>
            <Label text="Experience everything. Manage everything." styleClass="login-brand-tagline"/>
        </VBox>

        <VBox styleClass="login-form-panel" alignment="CENTER" HBox.hgrow="ALWAYS">
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" maxWidth="480">
                <VBox styleClass="login-card" alignment="CENTER_LEFT" spacing="0">
                    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                    <Label fx:id="loginHeaderTitle" text="Sign In" styleClass="login-heading"/>
                    <Label fx:id="loginHeaderSubtitle" text="Access your Apex Park workspace" styleClass="login-subheading"/>
                    
                    <VBox fx:id="signUpFieldsContainer" spacing="14" style="-fx-padding: 20 0 0 0;">
                        <HBox spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="First Name" styleClass="field-label"/>
                                <TextField fx:id="firstNameField" promptText="John" styleClass="text-field-flat"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Last Name" styleClass="field-label"/>
                                <TextField fx:id="lastNameField" promptText="Doe" styleClass="text-field-flat"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="6">
                            <Label text="Date of Birth" styleClass="field-label"/>
                            <DatePicker fx:id="dobPicker" promptText="MM/DD/YYYY" maxWidth="Infinity" styleClass="text-field-flat"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="6" style="-fx-padding: 14 0 0 0;">
                        <Label text="Email Address" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="name@domain.com" styleClass="text-field-flat"/>
                    </VBox>

                    <VBox spacing="6" style="-fx-padding: 14 0 0 0;">
                        <Label text="Password" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-field-flat"/>
                    </VBox>

                    <VBox fx:id="adminPrivilegeContainer" spacing="12" style="-fx-padding: 14 0 0 0;">
                        <CheckBox fx:id="adminCheckBox" text="Register as System Administrator" style="-fx-text-fill: -ap-text; -fx-cursor: hand; -fx-font-size: 13px;"/>
                        <VBox fx:id="masterKeyContainer" spacing="6">
                            <Label text="Master Verification Key" styleClass="field-label" style="-fx-text-fill: -ap-danger;"/>
                            <PasswordField fx:id="masterKeyField" promptText="Enter administrative clearance key" styleClass="text-field-flat"/>
                        </VBox>
                    </VBox>

                    <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true" style="-fx-padding: 12 0 0 0;"/>

                    <Button fx:id="primaryActionButton" text="Sign In" styleClass="btn-primary" maxWidth="Infinity" onAction="#handlePrimaryAction" defaultButton="true">
                        <VBox.margin><Insets top="20"/></VBox.margin>
                        <style>-fx-padding: 14 0 14 0; -fx-font-size: 14px; -fx-cursor: hand;</style>
                    </Button>

                    <HBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 0 0;">
                        <Label fx:id="toggleModeLabel" text="Don't have an account?" style="-fx-text-fill: -ap-text-muted; -fx-font-size: 13px;"/>
                        <Hyperlink fx:id="toggleModeLink" text="Sign Up" onAction="#handleToggleMode" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: -ap-accent; -fx-underline: false;"/>
                    </HBox>

                    <Label text="Apex Park Management System v1.1" styleClass="login-version" maxWidth="Infinity" alignment="CENTER">
                        <VBox.margin><Insets top="24"/></VBox.margin>
                    </Label>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</StackPane>