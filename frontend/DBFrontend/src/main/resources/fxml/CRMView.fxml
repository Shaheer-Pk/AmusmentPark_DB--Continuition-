<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amusementpark.CRMController"
      styleClass="view-container"
      spacing="20">

    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Customer CRM" styleClass="page-title"/>
            <Label text="Manage customers and their card balances" styleClass="page-subtitle"/>
        </VBox>
        <Button text="+ Add Customer" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <!-- Toolbar -->
    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <TextField fx:id="searchField"
                   promptText="Search by name..."
                   styleClass="text-field-flat"
                   prefWidth="300"
                   onKeyReleased="#handleSearch"/>
        <Button text="Search" styleClass="btn-secondary" onAction="#handleSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="recordCountLabel" text="0 records" styleClass="record-count-label"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="crmTable" styleClass="flat-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"        text="ID"          prefWidth="60"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colFirstName" text="First Name"  prefWidth="130"/>
            <TableColumn fx:id="colLastName"  text="Last Name"   prefWidth="130"/>
            <TableColumn fx:id="colType"      text="Type"        prefWidth="110"/>
            <TableColumn fx:id="colDOB"       text="Date of Birth" prefWidth="130"/>
            <TableColumn fx:id="colCardId"    text="Card ID"     prefWidth="80"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colBalance"   text="Balance (PKR)" prefWidth="130" style="-fx-alignment: CENTER_RIGHT;"/>
            <TableColumn fx:id="colPoints"    text="Points"      prefWidth="90"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colActions"   text="Actions"     prefWidth="180" style="-fx-alignment: CENTER;" sortable="false"/>
        </columns>
        <placeholder>
            <Label text="No customers found. Click '+ Add Customer' to get started." styleClass="table-placeholder"/>
        </placeholder>
    </TableView>
</VBox>
