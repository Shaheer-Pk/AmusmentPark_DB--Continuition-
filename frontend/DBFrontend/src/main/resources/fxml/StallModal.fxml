<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amusementpark.StallModalController"
      spacing="16" prefWidth="460">
    <padding><Insets top="8" right="4" bottom="8" left="4"/></padding>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="120" halignment="RIGHT"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Stall Name *"    GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField"        promptText="e.g. Burger Barn"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Type *"          GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeCombo"         promptText="Select type"
                  maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Rent (PKR) *"    GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="rentField"        promptText="0.00"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Owner *"         GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="ownerCombo"        promptText="Select owner"
                  maxWidth="Infinity"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Est. Date"       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="establishDatePicker"
                    maxWidth="Infinity"
                    GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Opening Time"    GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="openingTimeField" promptText="HH:MM  (e.g. 09:00)"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Closing Time"    GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="closingTimeField" promptText="HH:MM  (e.g. 22:00)"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel" styleClass="btn-secondary"/>
        <Button fx:id="saveBtn"   text="Save"   onAction="#handleSave"   styleClass="btn-primary"/>
    </HBox>
</VBox>
