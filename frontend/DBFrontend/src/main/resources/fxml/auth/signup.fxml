<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    signup.fxml — paired with SignupController.java

    LAYOUT: Mirrors login — StackPane → HBox split
      LEFT  — login-brand-panel  (same branding as login for continuity)
      RIGHT — login-form-panel   → login-card with GridPane form

    CSS CLASSES: all verified against style.css
      Same brand panel classes as login.fxml
      login-card, login-heading, login-subheading
      field-label, text-field-flat, combo-flat
      btn-primary, btn-secondary, error-label

    FX:ID → SignupController:
      roleLabel, firstNameField, lastNameField, phoneField,
      dobPicker, emailField, passwordField, confirmPasswordField

    ACTIONS → SignupController:
      handleSubmit(), handleBack()
-->

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.amusementpark.controller.SignupController"
           styleClass="root-pane">

    <HBox>

        <!-- ── LEFT: Brand Panel (identical to login for continuity) ──── -->
        <VBox styleClass="login-brand-panel"
              alignment="CENTER"
              spacing="0"
              HBox.hgrow="ALWAYS">

            <Label text="🎡" styleClass="login-brand-icon"/>
            <Label text="APEX PARK" styleClass="login-brand-title"/>
            <Label text="Management System" styleClass="login-brand-subtitle"/>
            <Label text="Experience everything. Manage everything."
                   styleClass="login-brand-tagline"
                   wrapText="true"
                   maxWidth="280"
                   style="-fx-text-alignment: CENTER;"/>

        </VBox>

        <!-- ── RIGHT: Signup Form Panel ───────────────────────────────── -->
        <VBox styleClass="login-form-panel"
              alignment="CENTER"
              HBox.hgrow="ALWAYS">

            <ScrollPane fitToWidth="true"
                        maxWidth="480"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">

                <VBox styleClass="login-card"
                      alignment="CENTER_LEFT"
                      spacing="0">
                    <padding>
                        <Insets top="36" right="40" bottom="36" left="40"/>
                    </padding>

                    <!-- Dynamic heading — set by SignupController.initRole()
                         roleLabel sets its own text in SignupController -->
                    <Label fx:id="roleLabel"
                           styleClass="login-heading"/>
                    <Label text="Fill in your details to get started"
                           styleClass="login-subheading"/>

                    <!-- Form fields -->
                    <VBox spacing="14" style="-fx-padding: 24 0 0 0;">

                        <!-- First + Last Name row -->
                        <HBox spacing="12">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="First Name" styleClass="field-label"/>
                                <TextField fx:id="firstNameField"
                                           promptText="John"
                                           styleClass="text-field-flat"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Last Name" styleClass="field-label"/>
                                <TextField fx:id="lastNameField"
                                           promptText="Doe"
                                           styleClass="text-field-flat"/>
                            </VBox>
                        </HBox>

                        <!-- Phone -->
                        <VBox spacing="6">
                            <Label text="Phone Number" styleClass="field-label"/>
                            <TextField fx:id="phoneField"
                                       promptText="+92 300 0000000"
                                       styleClass="text-field-flat"/>
                        </VBox>

                        <!-- Date of Birth -->
                        <VBox spacing="6">
                            <Label text="Date of Birth" styleClass="field-label"/>
                            <TextField fx:id="dobField"
                                        promptText="YYYY/MM/DD"
                                        maxWidth="Infinity"
                                        styleClass="text-field-flat"/>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="6">
                            <Label text="Email Address" styleClass="field-label"/>
                            <TextField fx:id="emailField"
                                       promptText="name@domain.com"
                                       styleClass="text-field-flat"/>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="6">
                            <Label text="Password" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField"
                                           promptText="Min. 8 characters"
                                           styleClass="text-field-flat"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6">
                            <Label text="Confirm Password" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Repeat your password"
                                           styleClass="text-field-flat"/>
                        </VBox>

                    </VBox>

                    <!-- Error label -->
                    <Label styleClass="error-label"
                           wrapText="true"
                           style="-fx-padding: 10 0 0 0;"/>

                    <!-- Action buttons -->
                    <HBox spacing="12" style="-fx-padding: 24 0 0 0;">

                        <Button text="← Back"
                                styleClass="btn-secondary"
                                onAction="#handleBack"
                                style="-fx-padding: 12 20 12 20;"/>

                        <Button text="Create Account"
                                styleClass="btn-primary"
                                onAction="#handleSubmit"
                                defaultButton="true"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                style="-fx-padding: 12 0 12 0; -fx-font-size: 13px;"/>

                    </HBox>

                    <!-- Back to login -->
                    <HBox alignment="CENTER" spacing="4" style="-fx-padding: 20 0 0 0;">
                        <Label text="Already have an account?"
                               style="-fx-text-fill: -ap-text-muted; -fx-font-size: 13px;"/>
                        <Hyperlink text="Sign In"
                                   onAction="#handleBack"
                                   style="-fx-font-size: 13px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: -ap-accent;
                                          -fx-underline: false;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>
</StackPane>
